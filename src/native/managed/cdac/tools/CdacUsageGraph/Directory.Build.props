<!-- Isolate this tool from the repo's Arcade Directory.Build.props (MSBuild stops
     walking up at the first Directory.Build.props it finds). -->
<Project>

  <!-- Consolidate all build output into a single artifacts/ folder under the tool root
       (the SDK "artifacts output" layout) instead of scattering bin/obj under each project.
       This mirrors the repo's top-level artifacts/ convention while staying isolated from Arcade. -->
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

</Project>
